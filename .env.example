# Database
DATABASE_URL="file:./dev.db"
# For PostgreSQL, use: DATABASE_URL="postgresql://user:password@localhost:5432/preptrac?schema=public"

# Optional: Email for notifications
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Required to enable scheduled notifications: a shared secret that gates the
# /api/cron/notifications endpoint (called by a Coolify Scheduled Task or cron).
# Generate one with: openssl rand -hex 32
CRON_SECRET=""

# App mode. Controls startup seeding and whether writes are allowed.
#   demo   = pre-seeded sample data AND read-only (no adds/edits/deletes)
#   seeded = pre-seeded sample data with full usage (writes allowed)
#   clean  = (default; also when unset/empty) empty slate, writes allowed
PREPTRAC_MODE=""
